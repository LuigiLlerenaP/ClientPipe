<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ClientPipe</PackageId>
    <Version>1.0.0</Version>
    <Description>Librería ligera para registrar clientes HTTP tipados con SocketsHttpHandler optimizado, validación de opciones al inicio (DataAnnotations) y lectura eficiente de Streams.</Description>
    <PackageTags>httpclient;options;resilience;dependency-injection;dotnet;stream</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

</Project>
